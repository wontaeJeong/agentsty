{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object" },
    "commonAnnotations": { "type": "object" },
    "imagePullSecrets": { "type": "array" },
    "namespaces": {
      "type": "object",
      "properties": {
        "system": { "$ref": "#/definitions/namespace" },
        "sessions": { "$ref": "#/definitions/namespace" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "extraControllerRules": { "type": "array" }
      }
    },
    "sessionToken": {
      "type": "object",
      "properties": {
        "createSecret": { "type": "boolean" },
        "secretName": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "existingSecret": { "$ref": "#/definitions/secretRef" }
      }
    },
    "api": { "$ref": "#/definitions/componentWithService" },
    "modelProxy": {
      "allOf": [
        { "$ref": "#/definitions/componentWithService" },
        {
          "type": "object",
          "properties": {
            "upstream": {
              "type": "object",
              "properties": {
                "url": { "type": "string" },
                "createSecret": { "type": "boolean" },
                "secretName": { "type": "string", "minLength": 1 },
                "key": { "type": "string", "minLength": 1 },
                "value": { "type": "string" },
                "existingSecret": { "$ref": "#/definitions/secretRef" }
              }
            },
            "service": {
              "allOf": [
                { "$ref": "#/definitions/service" },
                {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "enum": ["ClusterIP"] }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "controller": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        {
          "type": "object",
          "properties": {
            "runtimeImage": {
              "type": "object",
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string" }
              }
            },
            "modelProxyURL": { "type": "string" }
          }
        }
      ]
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowDNS": { "type": "boolean" },
        "extraEgress": { "type": "array" }
      }
    },
    "runtimeClass": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "handler": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "namespace": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "labels": { "type": "object" },
        "annotations": { "type": "object" }
      }
    },
    "secretRef": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "component": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "resources": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "componentWithService": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        {
          "type": "object",
          "properties": {
            "service": { "$ref": "#/definitions/service" },
            "args": {
              "type": "object",
              "properties": {
                "addr": { "type": "string" }
              }
            }
          }
        }
      ]
    }
  }
}
